# RepoMind Environment Configuration Template

# Optional: GitHub Personal Access Token (increases rate limit from 60 to 5,000 requests/hour)
GITHUB_TOKEN=

# LLM Provider: "auto", "gemini", "openai", or "local" (heuristic reasoning engine without API key)
LLM_PROVIDER=auto

# Google Gemini API Key (recommended)
GEMINI_API_KEY=

# OpenAI API Key (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding Provider: "fast-embed" (CPU, no download), "sentence-transformers", "gemini", or "openai"
EMBEDDING_PROVIDER=fast-embed

# Retrieval & Ingestion Tuning
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_TOP_K=4
DEFAULT_GRAPH_DEPTH=2
